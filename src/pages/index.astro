---
import { Image } from "astro:assets";

import featProjeto from "../assets/images/feat-projeto.jpg";
import featPlanner from "../assets/images/problem-illustration.png";
import featFinanceiro from "../assets/images/feat-financeiro.jpg";
import featPatrimonio from "../assets/images/feat-patrimonio.jpg";
import seloGarantia from "../assets/images/selo-garantia.png";

// ---------------------------------------------------------------------------
// SEO
// ---------------------------------------------------------------------------
const title =
	"Método Tático School | Planilha Inteligente de Produtividade & Metas";
const description =
	"Organize sua rotina, alcance seus objetivos e pare de desperdiçar tempo. Conheça a Planilha Inteligente do Método Tático School com Gestão Financeira e Patrimônio inclusos.";

// Checkout link routing
// You can set your custom checkout URL here (e.g. Kiwify, Hotmart, Eduzz, etc.)
const CHECKOUT_URL = "";

// ---------------------------------------------------------------------------
// Ícones (Phosphor)
// ---------------------------------------------------------------------------
const checkPath =
	"M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z";
const arrowPath =
	"M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z";
const folderPath =
	"M216,72H131.31L104,44.69A15.88,15.88,0,0,0,92.69,40H40A16,16,0,0,0,24,56V200.62A15.41,15.41,0,0,0,39.39,216h177.5A15.13,15.13,0,0,0,232,200.89V88A16,16,0,0,0,216,72ZM40,56H92.69l16,16H40Z";

// ---------------------------------------------------------------------------
// Conteúdo
// ---------------------------------------------------------------------------
const trustItems = [
	"Acesso Imediato",
	"7 Dias de Garantia 100%",
	"100% no Google Sheets (Sem mensalidades)",
];

const problems = [
	{
		num: "01",
		title: "Pare de fazer várias coisas ao mesmo tempo",
		text: "O mito da multitarefa divide seu foco, multiplica erros e gera exaustão sem que nada chegue ao fim. O Método Tático ensina a priorizar a única coisa que realmente move o ponteiro hoje.",
		tag: "Foco Direcionado",
		tilt: "ds-tilt-left",
	},
	{
		num: "02",
		title: "Nunca mais adie tarefas e metas importantes",
		text: "A procrastinação não é preguiça — é falta de clareza do próximo passo. Com objetivos desmembrados em etapas acessíveis, você vence a inércia e executa sem resistência.",
		tag: "Fim da Procrastinação",
		tilt: "",
	},
	{
		num: "03",
		title: 'Não diga mais "sim" para tudo e todos',
		text: "Quem não tem um planejamento visível vira refém da agenda alheia. Assuma o leme da sua rotina, aprenda a blindar suas horas produtivas e preserve sua energia para suas conquistas.",
		tag: "Domínio da Agenda",
		tilt: "ds-tilt-right",
	},
];

const features = [
	{
		meta: "Planejamento Macro",
		bonus: false,
		image: featProjeto,
		alt: "Projetos",
		title: "Projetos: Detalhando as etapas do seu objetivo",
		text: "Aprenda a quebrar metas complexas em passos sequenciais claros. Tenha uma linha do tempo realista para nunca mais ficar perdido no meio do caminho.",
		bullets: [
			"Estrutura de fases e marcos com prazos tangíveis",
			"Controle visual de status: A Fazer, Em Andamento e Concluído",
		],
	},
	{
		meta: "Execução Diária",
		bonus: false,
		image: featPlanner,
		alt: "Planner GPS",
		title: "Planner: O GPS que te levará ao seu destino",
		text: "O centro de comando da sua rotina diária. Elimine a ansiedade matinal sabendo com exatidão o que precisa ser feito a cada hora do dia.",
		bullets: [
			"Painel diário e semanal com visual limpo e sem distrações",
			"Acesse e edite em qualquer lugar pelo aplicativo Google Sheets",
		],
	},
	{
		id: "bonus",
		badge: "Bônus Especial 01",
		meta: "100% Grátis",
		bonus: true,
		image: featFinanceiro,
		alt: "Controle Financeiro",
		title: "Gestão Financeira Descomplicada",
		text: "Produtividade e tranquilidade financeira caminham lado a lado. Domine suas entradas, saídas, custos fixos e saiba exatamente quanto pode poupar a cada mês.",
		bullets: [
			"Categorização simples de despesas e receitas",
			"Cálculo automatizado do fluxo de caixa sem complicação",
		],
	},
	{
		badge: "Bônus Especial 02",
		meta: "100% Grátis",
		bonus: true,
		image: featPatrimonio,
		alt: "Evolução Patrimonial",
		title: "Controle & Evolução de Patrimônio",
		text: "Acompanhe o crescimento dos seus bens, investimentos e reservas ao longo do tempo. Veja seu patrimônio líquido evoluir mês após mês com métricas claras.",
		bullets: [
			"Visão consolidada de ativos, contas e investimentos",
			"Metas financeiras de médio e longo prazo registradas",
		],
	},
];

const checklist = [
	{
		strong: "Planilha Tático School Completa",
		rest: " (Google Sheets) pronta para duplicar e usar",
	},
	{
		strong: "Módulo de Projetos Táticos",
		rest: " para detalhar etapas e prazos de qualquer meta",
	},
	{
		strong: "Módulo Planner Tático (GPS)",
		rest: " para organização das suas tarefas diárias e semanais",
	},
	{
		strong: "[SUPER BÔNUS 1] Planilha de Controle Financeiro Pessoal",
		rest: " completa",
	},
	{
		strong: "[SUPER BÔNUS 2] Painel de Controle e Evolução de Patrimônio",
		rest: "",
	},
	{
		strong: "Aulas didáticas de implementação",
		rest: " ensinando como utilizar cada ferramenta",
	},
	{ strong: "Suporte individual dedicado:", rest: " Via e-mail" },
	{
		strong: "Acesso vitalício à sua cópia:",
		rest: " Sem mensalidades, sem custos extras",
	},
];

const faqs = [
	{
		q: "Como funciona o suporte?",
		a: "Nos primeiros 07 dias você tem o suporte pelo e-mail, depois você também terá suporte via WhatsApp direto para tirar dúvidas sobre o uso e aplicação da planilha.",
	},
	{
		q: "Preciso investir para aplicar as técnicas desse método?",
		a: "Você não vai precisar investir nada além do valor promocional de acesso. Não há mensalidades nem compra de softwares pagos. Apenas com as ferramentas gratuitas fornecidas (como o Google Sheets) você já se tornará mais produtivo.",
	},
	{
		q: "O acesso é vitalício?",
		a: "A cópia que você cria para si é sua para sempre!",
	},
	{
		q: "Consigo acompanhar meu planner no celular?",
		a: "Sim! Você pode checar, preencher e atualizar seu planner a qualquer hora diretamente no aplicativo Google Planilhas do seu celular (iOS ou Android), sincronizado em tempo real com o computador.",
	},
	{
		q: "Em que formato é o planner?",
		a: "O planner é em formato de Planilha do Google (Google Sheets). Você recebe o acesso por e-mail e com um único clique gera a sua cópia pessoal na nuvem, pronta para uso.",
	},
	{
		q: "Para quem é o planner?",
		a: "Para qualquer pessoa que precisa organizar suas tarefas, projetos e objetivos de maneira clara, visual e detalhada — seja você um profissional autônomo, estudante, empreendedor ou alguém buscando mais foco no dia a dia.",
	},
];

const footerLinks = [
	{ href: "#hero", label: "Início" },
	{ href: "#metodo", label: "O Método" },
	{ href: "#solucao", label: "O Que Inclui" },
	{ href: "#oferta", label: "Garantir Vaga" },
	{ href: "#garantia", label: "Garantia 7 Dias" },
	{ href: "#faq", label: "FAQ" },
];

const year = 2027;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, viewport-fit=cover"
		/>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="max-image-preview:large" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="pt_BR" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<!-- Meta Pixel Code -->
		<script is:inline>
			!(function (f, b, e, v, n, t, s) {
				if (f.fbq) return;
				n = f.fbq = function () {
					n.callMethod
						? n.callMethod.apply(n, arguments)
						: n.queue.push(arguments);
				};
				if (!f._fbq) f._fbq = n;
				n.push = n;
				n.loaded = !0;
				n.version = "2.0";
				n.queue = [];
				t = b.createElement(e);
				t.async = !0;
				t.src = v;
				s = b.getElementsByTagName(e)[0];
				s.parentNode.insertBefore(t, s);
			})(
				window,
				document,
				"script",
				"https://connect.facebook.net/en_US/fbevents.js",
			);
			fbq("init", "755309876572693");
			fbq("track", "PageView");
		</script>
		<noscript>
			<img
				height="1"
				width="1"
				style="display:none"
				src="https://www.facebook.com/tr?id=755309876572693&ev=PageView&noscript=1"
				alt=""
			/>
		</noscript>
		<!-- End Meta Pixel Code -->

		<!-- Google tag (gtag.js) -->
		<script
			is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-08RLCD95HF"
		></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", "G-08RLCD95HF");
		</script>
		<!-- End Google tag -->

		<!-- Microsoft Clarity -->
		<script is:inline>
			(function (c, l, a, r, i, t, y) {
				c[a] =
					c[a] ||
					function () {
						(c[a].q = c[a].q || []).push(arguments);
					};
				t = l.createElement(r);
				t.async = 1;
				t.src = "https://www.clarity.ms/tag/" + i;
				y = l.getElementsByTagName(r)[0];
				y.parentNode.insertBefore(t, y);
			})(window, document, "clarity", "script", "uufogsuwyj");
		</script>
		<!-- End Clarity -->
	</head>

	<body>
		<!-- Background Ambience (Skewed Rays & Grain) -->
		<div class="ds-bg-viewport" aria-hidden="true">
			<div class="ds-bg-rays">
				{Array.from({ length: 5 }).map(() => <div class="ds-bg-ray" />)}
			</div>
			<div class="ds-bg-noise"></div>
		</div>

		<div class="ds-app">
			<!-- Top Urgent Notice Bar -->
			<aside class="ds-topbar" aria-label="Aviso de promoção">
				<span class="ds-topbar-tag">Condição {year}</span>
				<span>
					Acesso completo ao <strong
						>Método Tático School + 2 Bônus</strong
					> por apenas <strong>R$ 37</strong>!
				</span>
			</aside>

			<main class="ds-main">
				<!-- ===================================================================
				     HERO SECTION: VSL & Value Proposition
				     =================================================================== -->
				<section class="ds-hero" id="hero">
					<div class="ds-container">
						<div class="ds-hero-header">
							<div class="ds-eyebrow">
								<span class="ds-eyebrow-line" aria-hidden="true"
								></span>
								<em>Produtividade &amp; Organização Tática</em>
								<span
									class="ds-eyebrow-line reverse"
									aria-hidden="true"></span>
							</div>

							<h1 class="ds-heading-display">
								Identificar seus objetivos é o caminho <span
									class="tone-secondary"
									>mais rápido para o sucesso.</span
								>
							</h1>

							<p class="ds-lead">
								Pare de perder dias inteiros com tarefas
								dispersas. Conheça a <strong
									>Planilha Inteligente do Método Tático</strong
								>: um sistema prático no Google Sheets que
								transforma o caos da rotina em foco, clareza e
								execução diária — acessível no celular e no
								computador.
							</p>
						</div>

						<!-- Video Presentation -->
						<div class="ds-video-stage">
							<div class="ds-video-frame">
								<div class="ds-video-header">
									<div
										class="ds-video-dots"
										aria-hidden="true"
									>
										<span class="ds-video-dot"></span>
										<span class="ds-video-dot"></span>
										<span class="ds-video-dot"></span>
									</div>
									<span>AULA EXPLICATIVA DO MÉTODO</span>
									<span class="ds-video-quality">
										<span
											class="ds-pulse-dot ds-pulse-dot-sm"
										></span>
										HD 1080p
									</span>
								</div>

								<div
									class="ds-video-container"
									id="video-container"
								>
									<iframe
										id="hero-video"
										src="https://www.youtube-nocookie.com/embed/16wioWcUfV0?rel=0&modestbranding=1&controls=0&disablekb=1&fs=0&iv_load_policy=3&playsinline=1&enablejsapi=1"
										title="Apresentação do Método Tático School"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
										referrerpolicy="strict-origin-when-cross-origin"
									></iframe>

									<!-- Custom Play/Pause (único controle visível) -->
									<button
										type="button"
										class="ds-video-toggle"
										id="video-toggle"
										aria-label="Reproduzir vídeo"
									>
										<span
											class="ds-video-toggle-icon"
											aria-hidden="true"
										>
											<svg
												class="ds-icon-play"
												viewBox="0 0 24 24"
												fill="currentColor"
											>
												<path
													d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.6-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z"
												></path>
											</svg>
											<svg
												class="ds-icon-pause"
												viewBox="0 0 24 24"
												fill="currentColor"
											>
												<rect
													x="6"
													y="5"
													width="4"
													height="14"
													rx="1"></rect>
												<rect
													x="14"
													y="5"
													width="4"
													height="14"
													rx="1"></rect>
											</svg>
										</span>
									</button>
								</div>
							</div>
						</div>

						<!-- CTA & Trust Pillars -->
						<div class="ds-hero-actions">
							<div class="ds-btn-pill-wrap ds-btn-pill-wrap-pink">
								<a
									href="#oferta"
									class="ds-btn-pill ds-btn-pill-pink"
									id="hero-cta"
								>
									<span>QUERO DAR O PRIMEIRO PASSO</span>
									<span
										class="ds-btn-arrow"
										aria-hidden="true"
									>
										<svg
											width="14"
											height="14"
											viewBox="0 0 256 256"
											fill="currentColor"
											><path d={arrowPath}></path></svg
										>
									</span>
								</a>
							</div>

							<div class="ds-trust-pills">
								{
									trustItems.map((item) => (
										<span class="ds-trust-item">
											<svg
												viewBox="0 0 256 256"
												fill="currentColor"
											>
												<path d={checkPath} />
											</svg>
											{item}
										</span>
									))
								}
							</div>
						</div>
					</div>
				</section>

				<!-- ===================================================================
				     PROBLEM SECTION
				     =================================================================== -->
				<section class="ds-section" id="metodo">
					<div class="ds-container">
						<div class="ds-section-header">
							<div class="ds-eyebrow">
								<span class="ds-eyebrow-line" aria-hidden="true"
								></span>
								<em>Chega de Sobrecarga e Frustração</em>
								<span
									class="ds-eyebrow-line reverse"
									aria-hidden="true"></span>
							</div>
							<h2 class="ds-heading-section">
								Você não vai mais desperdiçar seu tempo:
							</h2>
							<p class="ds-lead">
								Três armadilhas silenciosas que roubam horas
								preciosas da sua semana e impedem você de
								alcançar o que realmente planejou.
							</p>
						</div>

						<div class="ds-grid-3">
							{
								problems.map((p) => (
									<article
										class:list={[
											"ds-card-raised",
											"ds-problem-card",
											p.tilt,
										]}
									>
										<div>
											<div class="ds-badge-num">
												{p.num}
											</div>
											<h3>{p.title}</h3>
											<p>{p.text}</p>
										</div>
										<span class="ds-card-tag">{p.tag}</span>
									</article>
								))
							}
						</div>
					</div>
				</section>

				<!-- ===================================================================
				     SOLUTION SECTION
				     =================================================================== -->
				<section class="ds-section ds-section-tinted" id="solucao">
					<div class="ds-container">
						<div class="ds-section-header">
							<div class="ds-eyebrow">
								<span class="ds-eyebrow-line" aria-hidden="true"
								></span>
								<em>O Ecossistema Completo</em>
								<span
									class="ds-eyebrow-line reverse"
									aria-hidden="true"></span>
							</div>
							<h2 class="ds-heading-section">
								O que você vai dominar e receber com esse método
							</h2>
							<p class="ds-lead">
								Uma estrutura pronta, validada e intuitiva no
								Google Sheets. Você só precisa abrir e seguir o
								passo a passo para transformar sua
								produtividade.
							</p>
						</div>

						<div class="ds-grid-2">
							{
								features.map((f) => (
									<article
										class="ds-card-raised ds-feature-card"
										id={f.id}
									>
										<div>
											<div class="ds-feature-badge-wrap">
												{f.badge && (
													<span
														class:list={[
															"ds-feature-badge",
															{ bonus: f.bonus },
														]}
													>
														{f.badge}
													</span>
												)}
												<span
													class:list={[
														"ds-feature-meta",
														{ "is-bonus": f.bonus },
													]}
												>
													{f.meta}
												</span>
											</div>
											<div class="ds-feature-media has-cover">
												<Image
													src={f.image}
													alt={f.alt}
													class="is-cover"
													widths={[400, 800]}
													sizes="(max-width: 809px) 100vw, 560px"
													loading="lazy"
												/>
											</div>
											<div class="ds-feature-content">
												<h3>{f.title}</h3>
												<p>{f.text}</p>
												<ul class="ds-feature-bullets">
													{f.bullets.map((b) => (
														<li class="ds-feature-bullet">
															<svg
																viewBox="0 0 256 256"
																fill="currentColor"
															>
																<path
																	d={
																		checkPath
																	}
																/>
															</svg>
															{b}
														</li>
													))}
												</ul>
											</div>
										</div>
									</article>
								))
							}
						</div>
					</div>
				</section>

				<!-- ===================================================================
				     MANIFESTO BREAK
				     =================================================================== -->
				<section class="ds-section ds-manifesto">
					<div class="ds-container">
						<div class="ds-card-dark">
							<div class="ds-manifesto-inner">
								<div class="ds-eyebrow ds-eyebrow-dark">
									<span
										class="ds-eyebrow-line"
										aria-hidden="true"></span>
									<span
										class="ds-eyebrow-line reverse"
										aria-hidden="true"></span>
								</div>
								<h2>
									A diferença entre o sucesso e o fracasso
									está em como você escolhe agir hoje!
								</h2>
								<p>
									Continuar procrastinando e adiando seus
									sonhos... ou investir menos de R$ 0,11 por
									dia para ter domínio definitivo sobre sua
									rotina, suas metas e seu futuro?
								</p>

								<div
									class="ds-btn-pill-wrap ds-btn-pill-wrap-inverse"
								>
									<a
										href="#oferta"
										class="ds-btn-pill ds-btn-pill-inverse"
										id="manifesto-cta"
									>
										<span>QUERO MUDAR MEUS RESULTADOS</span>
										<span
											class="ds-btn-arrow"
											aria-hidden="true"
										>
											<svg
												width="14"
												height="14"
												viewBox="0 0 256 256"
												fill="currentColor"
												><path d={arrowPath}
												></path></svg
											>
