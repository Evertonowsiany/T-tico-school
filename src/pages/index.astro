		<!-- Interactive JavaScript -->
		<script>
			// FAQ Accordion Toggle
			const faqItems =
				document.querySelectorAll<HTMLElement>(".ds-faq-item");

			faqItems.forEach((item) => {
				const trigger =
					item.querySelector<HTMLButtonElement>(".ds-faq-trigger");
				trigger?.addEventListener("click", () => {
					const isActive = item.classList.contains("active");

					// Close all other items
					faqItems.forEach((el) => {
						el.classList.remove("active");
						el.querySelector(".ds-faq-trigger")?.setAttribute(
							"aria-expanded",
							"false",
						);
					});

					// Toggle current
					if (!isActive) {
						item.classList.add("active");
						trigger.setAttribute("aria-expanded", "true");
					}
				});
			});

			// Modal Handlers
			const openModal = (id: string) =>
				document.getElementById(id)?.classList.add("open");
			const closeModal = (id: string) =>
				document.getElementById(id)?.classList.remove("open");

			document
				.querySelectorAll<HTMLElement>("[data-open-modal]")
				.forEach((btn) => {
					btn.addEventListener("click", () =>
						openModal(btn.dataset.openModal!),
					);
				});

			document
				.querySelectorAll<HTMLElement>("[data-close-modal]")
				.forEach((btn) => {
					btn.addEventListener("click", () =>
						closeModal(btn.dataset.closeModal!),
					);
				});

			document
				.querySelectorAll<HTMLElement>(".ds-modal-backdrop")
				.forEach((backdrop) => {
					backdrop.addEventListener("click", (event) => {
						if (event.target === backdrop) closeModal(backdrop.id);
					});
				});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") {
					document
						.querySelectorAll(".ds-modal-backdrop.open")
						.forEach((m) => m.classList.remove("open"));
				}
			});

			// Checkout link routing (URL definida no frontmatter: CHECKOUT_URL)
			const checkoutBtn = document.getElementById("btn-checkout");
			checkoutBtn?.addEventListener("click", () => {
				const url = checkoutBtn.dataset.checkoutUrl?.trim();
				if (url) {
					window.open(url, "_blank");
				} else {
					// Smooth scroll to offer section if no checkout URL configured yet
					document
						.getElementById("oferta")
						?.scrollIntoView({ behavior: "smooth" });
				}
			});

			// YouTube Player — apenas Play/Pause (controles nativos ocultos via controls=0)
			const videoContainer = document.getElementById("video-container");
			const videoToggle = document.getElementById("video-toggle");
			const videoIframe = document.getElementById("hero-video");

			if (videoContainer && videoToggle && videoIframe) {
				const w = window as any;
				let player: any = null;
				let playerReady = false;
				let pendingPlay = false;
				let isPlaying = false;
				let hideTimer: number | undefined;
				let suppressUntil = 0;

				// Mostra o botão por alguns instantes e esconde de novo (comportamento de player real)
				const hideControls = () => {
					window.clearTimeout(hideTimer);
					videoContainer.classList.remove("show-controls");
				};
				const showControlsBriefly = (delay = 2000) => {
					if (!isPlaying || Date.now() < suppressUntil) return;
					videoContainer.classList.add("show-controls");
					window.clearTimeout(hideTimer);
					hideTimer = window.setTimeout(hideControls, delay);
				};

				const setPlayingUI = (playing: boolean) => {
					isPlaying = playing;
					videoContainer.classList.toggle("is-playing", playing);
					videoToggle.setAttribute(
						"aria-label",
						playing ? "Pausar vídeo" : "Reproduzir vídeo",
					);
					if (playing) {
						// Some imediatamente ao dar play e ignora o "tremido" do mouse logo após o clique
						suppressUntil = Date.now() + 1200;
					}
					hideControls();
				};

				const initPlayer = () => {
					const S = w.YT.PlayerState;
					player = new w.YT.Player(videoIframe, {
						events: {
							onReady: () => {
								playerReady = true;
								if (pendingPlay) {
									pendingPlay = false;
									player.playVideo();
								}
							},
							onStateChange: (event: any) => {
								const state = event.data;
								// Ignora estados transitórios (UNSTARTED/CUED) para não piscar o botão
								if (
									state === S.PLAYING ||
									state === S.BUFFERING
								) {
									if (!isPlaying) setPlayingUI(true);
								} else if (
									state === S.PAUSED ||
									state === S.ENDED
								) {
									if (isPlaying) setPlayingUI(false);
								}

								// Ao terminar, volta ao início pausado (evita a tela de vídeos sugeridos)
								if (state === S.ENDED) {
									player.seekTo(0, true);
									player.pauseVideo();
								}
							},
						},
					});
				};

				if (w.YT?.Player) {
					initPlayer();
				} else {
					const previousReady = w.onYouTubeIframeAPIReady;
					w.onYouTubeIframeAPIReady = () => {
						previousReady?.();
						initPlayer();
					};
					const ytScript = document.createElement("script");
					ytScript.src = "https://www.youtube.com/iframe_api";
					ytScript.async = true;
					document.head.appendChild(ytScript);
				}

				videoToggle.addEventListener("click", () => {
					// No touch, se o botão estiver escondido, o 1º toque só revela o controle
					const isTouch = window.matchMedia("(hover: none)").matches;
					if (
						isTouch &&
						isPlaying &&
						!videoContainer.classList.contains("show-controls")
					) {
						suppressUntil = 0;
						showControlsBriefly(2500);
						return;
					}

					if (isPlaying) {
						setPlayingUI(false);
						pendingPlay = false;
						if (player && playerReady) player.pauseVideo();
					} else {
						// Atualização otimista: o botão some na hora, sem esperar o YouTube responder
						setPlayingUI(true);
						if (player && playerReady) {
							player.playVideo();
						} else {
							pendingPlay = true;
						}
					}
				});

				// Desktop: mexer o mouse sobre o vídeo revela o botão de pausa por 2s
				videoToggle.addEventListener("mousemove", () =>
					showControlsBriefly(),
				);
				videoToggle.addEventListener("mouseleave", hideControls);
			}
		</script>
	</body>
</html>

<style is:global>
