		background: linear-gradient(
			180deg,
			rgba(255, 255, 255, 0.7) 0%,
			rgba(255, 255, 255, 0) 100%
		);
		transform: skewX(45deg);
		filter: blur(28px);
	}

	.ds-bg-ray:nth-child(1) {
		left: 10%;
		opacity: 0.45;
		width: 180px;
	}
	.ds-bg-ray:nth-child(2) {
		left: 32%;
		opacity: 0.35;
		width: 120px;
	}
	.ds-bg-ray:nth-child(3) {
		left: 55%;
		opacity: 0.5;
		width: 220px;
	}
	.ds-bg-ray:nth-child(4) {
		left: 78%;
		opacity: 0.3;
		width: 160px;
	}
	.ds-bg-ray:nth-child(5) {
		left: 92%;
		opacity: 0.4;
		width: 110px;
	}

	.ds-bg-noise {
		position: absolute;
		inset: 0;
		background-image: url("/assets/noise.png");
		background-repeat: repeat;
		background-size: 150px auto;
		opacity: 0.045;
		mix-blend-mode: multiply;
	}

	/* Foreground Container */
	.ds-app {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
	}

	.ds-main {
		width: 100%;
	}

	.ds-container {
		width: 100%;
		max-width: var(--ds-max-w);
		padding-left: clamp(16px, 4vw, 40px);
		padding-right: clamp(16px, 4vw, 40px);
		margin-left: auto;
		margin-right: auto;
	}

	/* ==========================================================================
	   TOP NOTIFICATION BAR
	   ========================================================================== */
	.ds-topbar {
		width: 100%;
		background: #000000;
		color: #ffffff;
		padding: 8px 16px;
		font-size: 12.5px;
		font-weight: 500;
		letter-spacing: -0.01em;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 10px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.15);
		position: relative;
		z-index: 20;
	}

	.ds-topbar strong {
		color: #ffaa88;
	}

	.ds-topbar-tag {
		background: var(--ds-accent);
		color: #ffffff;
		font-size: 10.5px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 2px 7px;
		border-radius: 4px;
	}

	/* ==========================================================================
	   BRAND LOGO
	   ========================================================================== */
	.ds-brand-logo {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		background: var(--ds-ink);
		color: #ffffff;
		border-radius: 50%;
		font-size: 14px;
	}

	.ds-brand-logo svg {
		width: 18px;
		height: 18px;
		fill: #ffffff;
	}

	.ds-brand-logo-inverse {
		background: #ffffff;
		color: #000000;
	}

	.ds-brand-logo-inverse svg {
		fill: #000000;
	}

	/* Pulse dot */
	.ds-pulse-dot {
		width: 7px;
		height: 7px;
		background-color: var(--ds-status-green);
		border-radius: 50%;
		box-shadow: 0 0 0 0 var(--ds-status-green-glow);
		animation: pulse-ring 2s infinite;
	}

	.ds-pulse-dot-sm {
		width: 6px;
		height: 6px;
	}

	@keyframes pulse-ring {
		0% {
			box-shadow: 0 0 0 0 rgba(12, 179, 0, 0.6);
		}
		70% {
			box-shadow: 0 0 0 8px rgba(12, 179, 0, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(12, 179, 0, 0);
		}
	}

	/* ==========================================================================
	   TYPOGRAPHY SYSTEM (Eyebrow, Headings, Leads)
	   ========================================================================== */
	.ds-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 14px;
	}

	.ds-eyebrow-tight {
		margin-bottom: 8px;
	}

	.ds-eyebrow-line {
		width: 28px;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.3));
	}

	.ds-eyebrow-line.reverse {
		background: linear-gradient(270deg, transparent, rgba(0, 0, 0, 0.3));
	}

	.ds-eyebrow em {
		font-family: var(--ds-font-serif);
		font-style: italic;
		font-size: clamp(20px, 2.4vw, 26px);
		color: rgba(0, 0, 0, 0.68);
		font-weight: 400;
		letter-spacing: 0.01em;
	}

	.ds-eyebrow-dark em {
		color: rgba(255, 255, 255, 0.75);
	}

	.ds-eyebrow-dark .ds-eyebrow-line {
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.3)
		);
	}

	.ds-eyebrow-dark .ds-eyebrow-line.reverse {
		background: linear-gradient(
			270deg,
			transparent,
			rgba(255, 255, 255, 0.3)
		);
	}

	.ds-heading-display {
		font-size: clamp(38px, 4.8vw, 68px);
		line-height: 1.08;
		font-weight: 500;
		letter-spacing: -0.05em;
		color: var(--ds-ink);
		margin-bottom: 20px;
	}

	.ds-heading-display em,
	.ds-heading-display .tone-secondary {
		color: var(--ds-text-secondary);
		font-style: normal;
		font-weight: 400;
	}

	.ds-heading-display .accent-text {
		color: var(--ds-accent);
	}

	.ds-heading-section {
		font-size: clamp(28px, 3.5vw, 44px);
		line-height: 1.15;
		font-weight: 500;
		letter-spacing: -0.04em;
		color: var(--ds-ink);
		margin-bottom: 16px;
	}

	.ds-lead {
		font-size: clamp(16px, 1.6vw, 20px);
		line-height: 1.5;
		color: var(--ds-text-secondary);
		max-width: 680px;
		margin-left: auto;
		margin-right: auto;
	}

	/* ==========================================================================
	   BUTTONS & CTAs (Tactile Pill Button with Glowing Ring)
	   ========================================================================== */
	.ds-btn-pill-wrap {
		display: inline-block;
		background: rgba(255, 255, 255, 0.38);
		padding: 6px;
		border-radius: var(--ds-radius-pill);
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05);
		transition:
			transform 0.25s ease,
			background-color 0.25s ease;
	}

	.ds-btn-pill-wrap:hover {
		transform: translateY(-2px);
		background: rgba(255, 255, 255, 0.6);
	}

	.ds-btn-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		background: var(--ds-ink);
		color: #ffffff !important;
		text-decoration: none;
		font-family: inherit;
		font-size: clamp(14px, 1.3vw, 16px);
		font-weight: 600;
		letter-spacing: -0.01em;
		padding: 16px 36px;
		border-radius: var(--ds-radius-pill);
		border: 0;
		cursor: pointer;
		box-shadow:
			inset 0 -12px 24px rgba(255, 255, 255, 0.08),
			0 8px 24px rgba(0, 0, 0, 0.25);
		transition: all 0.25s ease;
	}

	.ds-btn-pill:hover {
		background: #181818;
		box-shadow:
			inset 0 -12px 24px rgba(255, 255, 255, 0.12),
			0 12px 30px rgba(0, 0, 0, 0.32);
	}

	.ds-btn-pill .ds-btn-arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.18);
		transition:
			transform 0.25s ease,
			background-color 0.25s ease;
	}

	.ds-btn-pill:hover .ds-btn-arrow {
		transform: translateX(4px);
		background: var(--ds-accent);
	}

	/* Inverse pill (used on dark manifesto card) */
	.ds-btn-pill-wrap-inverse {
		background: rgba(255, 255, 255, 0.18);
	}

	.ds-btn-pill.ds-btn-pill-inverse {
		background: #ffffff;
		color: #000000 !important;
	}

	.ds-btn-pill.ds-btn-pill-inverse .ds-btn-arrow {
		background: rgba(0, 0, 0, 0.1);
		color: #000000;
	}

	.ds-btn-pill.ds-btn-pill-inverse:hover .ds-btn-arrow {
		background: var(--ds-accent);
		color: #ffffff;
	}

	/* Black variant for hero button */
	.ds-btn-pill-wrap-pink {
		background: rgba(0, 0, 0, 0.08);
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
	}

	.ds-btn-pill-wrap-pink:hover {
		background: rgba(0, 0, 0, 0.14);
	}

	.ds-btn-pill.ds-btn-pill-pink {
		background: linear-gradient(135deg, #1a1a1a 0%, #000000 100%);
		color: #ffffff !important;
		box-shadow:
			inset 0 -12px 24px rgba(255, 255, 255, 0.08),
			0 8px 24px rgba(0, 0, 0, 0.3);
	}

	.ds-btn-pill.ds-btn-pill-pink:hover {
		background: linear-gradient(135deg, #2a2a2a 0%, #0a0a0a 100%);
		box-shadow:
			inset 0 -12px 24px rgba(255, 255, 255, 0.12),
			0 12px 30px rgba(0, 0, 0, 0.4);
	}

	.ds-btn-pill.ds-btn-pill-pink .ds-btn-arrow {
		background: rgba(255, 255, 255, 0.18);
		color: #ffffff;
	}

	.ds-btn-pill.ds-btn-pill-pink:hover .ds-btn-arrow {
		background: #ffffff;
		color: #000000;
	}

	/* Secondary Button */
	.ds-btn-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		background: var(--ds-surface-raised);
		color: var(--ds-ink);
		text-decoration: none;
		font-size: 14.5px;
		font-weight: 600;
		padding: 14px 28px;
		border-radius: var(--ds-radius-pill);
		box-shadow: var(--ds-ring-white), var(--ds-shadow-raised);
		border: 1px solid rgba(255, 255, 255, 0.9);
		transition:
			transform 0.2s,
			box-shadow 0.2s;
	}

	.ds-btn-secondary:hover {
		transform: translateY(-2px);
		box-shadow:
			0 0 0 10px rgba(255, 255, 255, 0.4),
			var(--ds-shadow-floating);
	}

	/* ==========================================================================
	   CARDS & SURFACES (Raised, Dark)
	   ========================================================================== */
	.ds-card-raised {
		background: var(--ds-surface-raised);
		border-radius: var(--ds-radius-card);
		box-shadow: var(--ds-ring-white), var(--ds-shadow-raised);
		border: 1px solid rgba(255, 255, 255, 0.9);
		padding: clamp(24px, 3.5vw, 36px);
		transition:
			transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
			box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
	}

	.ds-card-raised:hover {
		transform: translateY(-4px);
		box-shadow:
			0 0 0 10px rgba(255, 255, 255, 0.42),
			var(--ds-shadow-floating);
	}

	/* Tilted spec cards (signature tactile rotation) */
	.ds-tilt-left {
		transform: rotate(-1.5deg);
	}

	.ds-tilt-right {
		transform: rotate(1.5deg);
	}

	.ds-tilt-left:hover,
	.ds-tilt-right:hover {
		transform: rotate(0deg) translateY(-5px);
	}

	.ds-card-dark {
		background: radial-gradient(
			100% 100% at 0% 0%,
			#2a2a2a 0%,
			#101010 100%
		);
		color: #ffffff;
		border-radius: 28px;
		box-shadow: var(--ds-ring-dark), var(--ds-shadow-dark);
		border: 1px solid rgba(255, 255, 255, 0.12);
		padding: clamp(28px, 4vw, 48px);
		position: relative;
		overflow: hidden;
	}

	/* ==========================================================================
	   HERO SECTION
	   ========================================================================== */
	.ds-hero {
		padding-top: clamp(24px, 4vw, 54px);
		padding-bottom: clamp(48px, 6vw, 80px);
		text-align: center;
	}

	.ds-hero-header {
		max-width: 900px;
		margin: 0 auto 36px;
	}

	.ds-hero-actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		margin-top: 30px;
	}

	.ds-trust-pills {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 16px 24px;
		margin-top: 10px;
	}

	.ds-trust-item {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		font-weight: 500;
		color: var(--ds-text-secondary);
	}

	.ds-trust-item svg {
		width: 16px;
		height: 16px;
		color: var(--ds-status-green);
	}

	/* Video Stage (Media Frame) */
	.ds-video-stage {
		max-width: 880px;
		margin: 40px auto 0;
		position: relative;
	}

	.ds-video-frame {
		background: #141414;
		border-radius: 24px;
		padding: 12px;
		box-shadow:
			0 0 0 8px rgba(255, 255, 255, 0.32),
			0 24px 60px rgba(0, 0, 0, 0.25);
		border: 1px solid rgba(255, 255, 255, 0.2);
		position: relative;
	}

	.ds-video-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 6px 14px 10px;
		color: rgba(255, 255, 255, 0.6);
		font-size: 12px;
		font-family: var(--ds-font-mono);
	}

	.ds-video-quality {
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}

	.ds-video-dots {
		display: flex;
		gap: 6px;
	}

	.ds-video-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.2);
	}

	.ds-video-dot:nth-child(1) {
		background: #ff5f56;
	}
	.ds-video-dot:nth-child(2) {
		background: #ffbd2e;
	}
	.ds-video-dot:nth-child(3) {
		background: #27c93f;
	}

	.ds-video-container {
		position: relative;
		width: 100%;
		padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
		height: 0;
		overflow: hidden;
		border-radius: 16px;
		background: #000000;
	}

	/*
	 * Esconde título (topo), logo do YouTube e botão de link (rodapé):
	 * o iframe fica mais alto que o container 16:9. O YouTube encaixa o vídeo pela
	 * largura (continua 100% visível), e as sobreposições — que ficam presas às
	 * bordas do iframe — caem nas faixas extras, cortadas pelo overflow: hidden.
	 */
	.ds-video-container {
		--yt-crop: 90px;
	}

	.ds-video-container iframe {
		position: absolute;
		top: calc(var(--yt-crop) * -1);
		left: 0;
		width: 100%;
		height: calc(100% + var(--yt-crop) * 2);
		border: 0;
		pointer-events: none;
	}

	/* Custom Play/Pause overlay — cobre o iframe e bloqueia cliques nos links do YouTube */
	.ds-video-toggle {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.ds-video-toggle-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 76px;
		height: 76px;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.72);
		color: #ffffff;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		box-shadow:
			0 0 0 6px rgba(255, 255, 255, 0.14),
			0 10px 28px rgba(0, 0, 0, 0.4);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	.ds-video-toggle-icon svg {
		width: 30px;
		height: 30px;
	}

	.ds-video-toggle-icon .ds-icon-play {
		margin-left: 4px; /* centraliza opticamente o triângulo */
	}

	.ds-video-toggle-icon .ds-icon-pause {
		display: none;
	}

	/* Hover só em dispositivos com mouse (evita o "hover preso" após toque no celular) */
	@media (hover: hover) {
		.ds-video-container:not(.is-playing)
			.ds-video-toggle:hover
			.ds-video-toggle-icon {
			transform: scale(1.06);
		}
	}

	.ds-video-container.is-playing .ds-icon-play {
		display: none;
	}

	.ds-video-container.is-playing .ds-icon-pause {
		display: block;
	}

	/* Durante a reprodução o botão some; volta só ao mexer o mouse / tocar (via JS) ou focar pelo teclado */
	.ds-video-container.is-playing .ds-video-toggle-icon {
		opacity: 0;
		transform: scale(0.85);
		pointer-events: none;
	}

	.ds-video-container.is-playing:not(.show-controls) .ds-video-toggle {
		cursor: none;
	}

	.ds-video-container.is-playing.show-controls .ds-video-toggle-icon,
	.ds-video-container.is-playing
		.ds-video-toggle:focus-visible
		.ds-video-toggle-icon {
		opacity: 1;
		transform: scale(1);
	}

	/* ==========================================================================
	   SECTIONS & PROBLEM CARDS
	   ========================================================================== */
	.ds-section {
		padding: clamp(50px, 7vw, 90px) 0;
		position: relative;
	}

	.ds-section-tinted {
		background: rgba(255, 255, 255, 0.45);
		border-top: 1px solid rgba(0, 0, 0, 0.06);
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
	}

	.ds-section-header {
		text-align: center;
		max-width: 780px;
		margin: 0 auto clamp(36px, 5vw, 56px);
	}

	.ds-grid-3 {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(20px, 2.5vw, 32px);
	}

	.ds-problem-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		text-align: left;
	}

	.ds-badge-num {
		width: 44px;
		height: 44px;
		border-radius: 14px;
		background: var(--ds-ink);
		color: #ffffff;
		display: grid;
		place-items: center;
		font-family: var(--ds-font-mono);
		font-size: 16px;
		font-weight: 700;
		margin-bottom: 20px;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
	}

	.ds-problem-card h3 {
		font-size: 20px;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ds-ink);
		margin-bottom: 12px;
		line-height: 1.3;
	}

	.ds-problem-card p {
		font-size: 15px;
		color: var(--ds-text-secondary);
		line-height: 1.6;
	}

	.ds-card-tag {
		display: inline-block;
		font-size: 11.5px;
		font-family: var(--ds-font-mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 4px 10px;
		border-radius: 6px;
		margin-top: 18px;
		width: fit-content;
		background: rgba(255, 55, 0, 0.08);
		color: var(--ds-accent);
		font-weight: 600;
	}

	/* ==========================================================================
	   SOLUTION & FEATURES SECTION
	   ========================================================================== */
	.ds-grid-2 {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: clamp(20px, 3vw, 36px);
	}

	.ds-feature-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
	}

	.ds-feature-badge-wrap {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 22px;
	}

	.ds-feature-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: rgba(0, 0, 0, 0.05);
		padding: 6px 14px;
		border-radius: var(--ds-radius-pill);
		font-size: 12.5px;
		font-weight: 600;
		color: var(--ds-ink);
	}

	.ds-feature-badge.bonus {
		background: rgba(255, 55, 0, 0.1);
		color: var(--ds-accent);
	}

	.ds-feature-meta {
		font-size: 13.8px;
		font-weight: 700;
		font-family: var(--ds-font-mono);
		color: var(--ds-text-tertiary);
	}

	.ds-feature-meta.is-bonus {
		color: var(--ds-accent);
	}

	.ds-feature-media {
		width: 100%;
		height: 190px;
		background: linear-gradient(135deg, #f2f2f2 0%, #e6e6e6 100%);
		border-radius: 16px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 22px;
		border: 1px solid rgba(0, 0, 0, 0.04);
		position: relative;
	}

	.ds-feature-media img {
		max-width: 120px;
		max-height: 120px;
		object-fit: contain;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* Preenchimento total do card (cover) */
	.ds-feature-media.has-cover {
		background: #0f172a;
		padding: 0;
	}

	.ds-feature-media.has-cover img,
	.ds-feature-media img.is-cover {
